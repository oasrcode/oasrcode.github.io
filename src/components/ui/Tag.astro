---
interface Props {
  label: string;
  /** Opt into the magnetic-cursor drift (desktop fine-pointer only). */
  magnetic?: boolean;
}

const { label, magnetic = false } = Astro.props;
---

<li class="tag" data-magnetic={magnetic ? '' : undefined}>
  <span class="tag__name">{label}</span>
</li>

<style>
  .tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.32rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    /* A faint lit top edge so the translucent chip reads as a surface catching
       the dive's light rather than a flat outline. */
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--spark) 12%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    line-height: 1.4;
    color: var(--ink);
  }
</style>
