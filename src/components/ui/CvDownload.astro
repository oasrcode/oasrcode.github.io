---
import type { Locale } from '../../data/content';
import { getUI } from '../../i18n';
import { CV_HREF } from '../../lib/cv';

interface Props {
  /** Server-rendered language used for the initial label. */
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = getUI(lang);
---

<!-- Static download: the owner supplies `public/cv.pdf`. Render this component
     only when that file exists (see `hasCv` in `src/lib/cv.ts`), so the link is
     never broken. `download` makes the browser save the file instead of
     navigating to it. -->
<a class="cv-download" href={CV_HREF} download data-i18n="cv.download">
  <svg
    class="cv-download__icon"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M8 1.75v8" />
    <path d="m4.75 6.5 3.25 3.25L11.25 6.5" />
    <path d="M2.75 13.5h10.5" />
  </svg>
  <span>{t.cv.download}</span>
</a>

<style>
  .cv-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .cv-download:hover {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.18em;
  }

  .cv-download__icon {
    flex: none;
  }
</style>
