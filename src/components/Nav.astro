---
import type { Locale } from '../data/content';
import { profile } from '../data/content';
import { getUI, htmlLang } from '../i18n';
import { CV_HREF, hasCv } from '../lib/cv';

interface Props {
  /** Server-rendered language (Spanish). */
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = getUI(lang);
---

<!--
  Progressive-enhancement gate. Runs before the bar paints: with JS the centre
  links collapse into the mobile burger; without it they stay visible in the
  flow. CSS keys off `html.nav-js`, so this never hides content from no-JS.

  The second class, `nav-scrolled`, is the bar's detached state. Setting it here
  (before the header exists in the DOM) means a page restored at a scroll offset
  paints already detached — no flash of the flush state, no reverse animation.
  Without JS neither class is added, so the bar stays flush and usable.
-->
<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add('nav-js');
    if ((window.scrollY || window.pageYOffset || 0) > 12) {
      root.classList.add('nav-scrolled');
    }
  })();
</script>

<header class="site-header" data-nav>
  <div class="nav-bar">
    <a class="nav-brand" href="/" aria-label={profile.wordmark}>
      <span class="nav-brand__word">{profile.wordmark}</span>
    </a>

    <nav
      class="nav-links"
      id="primary-nav"
      aria-label={t.nav.ariaLabel}
      data-i18n-attr="aria-label:nav.ariaLabel"
    >
      <ul class="nav-links__list">
        <li><a href="#work" data-i18n="nav.work">{t.nav.work}</a></li>
        {hasCv && (
          <li>
            <a href={CV_HREF} download data-i18n="nav.cv">{t.nav.cv}</a>
          </li>
        )}
        <li>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.nav.linkedinAria}
            data-i18n="nav.linkedin"
            data-i18n-attr="aria-label:nav.linkedinAria">{t.nav.linkedin}</a
          >
        </li>
        <li>
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.nav.githubAria}
            data-i18n="nav.github"
            data-i18n-attr="aria-label:nav.githubAria">{t.nav.github}</a
          >
        </li>
      </ul>
    </nav>

    <div class="nav-utils">
      <!-- Live clock — data, not motion. Filled per second by the nav client;
           without JS the placeholder stands. -->
      <span class="nav-clock">
        <span class="nav-sr" data-i18n="nav.clockLabel">{t.nav.clockLabel}</span>
        <time class="nav-clock__time" data-nav-clock datetime="">--:--:--</time>
      </span>

      <!--
        Segmented language switch. Two options; the active one is marked with
        `aria-current` by the existing i18n client, and the sliding background
        is a pure-CSS reaction to that state. No reload, no URL change.
      -->
      <div
        class="nav-lang"
        role="group"
        aria-label={t.langSwitch.label}
        data-i18n-attr="aria-label:langSwitch.label"
      >
        <span class="nav-lang__thumb" aria-hidden="true"></span>
        <button
          type="button"
          class="nav-lang__opt"
          data-lang-set="es"
          lang={htmlLang('es')}
          aria-label="Español"
          aria-current={lang === 'es' ? 'page' : undefined}>ES</button
        >
        <button
          type="button"
          class="nav-lang__opt"
          data-lang-set="en"
          lang={htmlLang('en')}
          aria-label="English"
          aria-current={lang === 'en' ? 'page' : undefined}>EN</button
        >
      </div>

      <button
        type="button"
        class="nav-burger"
        data-nav-burger
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={t.nav.menuLabel}
        data-i18n-attr="aria-label:nav.menuLabel"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { initNav } from '../lib/nav/client';

  initNav();
</script>

<style is:global>
  /* Nav-scoped tokens. New variables only — no existing token value changes. */
  :root {
    --nav-height: 68px;
    --nav-inset-x: clamp(0.75rem, 2.4vw, 1.4375rem); /* 12 → 23px lateral inset */
    --nav-inset-y: clamp(0.75rem, 1.1vw, 1rem); /* 12 → 16px top inset */
    --nav-radius: 14px;

    /* Scroll detach. At the top the bar is full-bleed (flush with the page
       top); past the threshold it insets into the floating rounded bar.
       Both padding values align the bar's content with the page container, so
       the content never jumps during the handoff. */
    --nav-dur: 0.4s;
    --nav-max-float: calc(var(--container) - 2 * var(--nav-inset-x));
    --nav-pad-flush: max(
      var(--gutter),
      calc((100% - var(--container)) / 2 + var(--gutter))
    );
    --nav-pad-float: max(0.5rem, calc(var(--gutter) - var(--nav-inset-x)));

    /* Dark instrument surface. */
    --nav-surface: #1a1a1e;
    --nav-raise: rgba(255, 255, 255, 0.07);
    --nav-active: rgba(255, 255, 255, 0.16);
    --nav-ink: #f1f1f5;
    --nav-muted: #9c9ca8;
    --nav-line: rgba(255, 255, 255, 0.1);
    --nav-spark: #6b78ff; /* spark lifted for a dark field (decorative mark) */
    --nav-shadow:
      0 14px 34px -14px rgba(8, 8, 12, 0.62),
      0 3px 10px -6px rgba(8, 8, 12, 0.5);

    /* Fixed bar clearance: content starts below the bar; anchors land under it.
       Sized for the detached (tallest) state so it clears the bar in both. */
    --nav-clearance: calc(var(--nav-height) + var(--nav-inset-y));
    --nav-scroll-offset: calc(var(--nav-height) + var(--nav-inset-y) + 1rem);
  }

  /* The bar is fixed and out of flow, so reserve its height at the top of the
     document (only on pages that render this nav). */
  body {
    padding-top: var(--nav-clearance);
  }

  /* Native anchor jumps (`#work`, skip link) clear the fixed bar. Lenis reads
     the same `scroll-padding-top`, so the smooth scroll does too. */
  html {
    scroll-padding-top: var(--nav-scroll-offset);
  }

  @media (max-width: 700px) {
    :root {
      --nav-height: 62px;
    }
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    margin-inline: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
    /* Flush at the top: no top offset, no lateral inset. The detach is a
       smooth hand-off of these two values plus the bar's shape. */
    transition:
      top var(--nav-dur) var(--ease-out),
      margin var(--nav-dur) var(--ease-out);
  }

  /* Detached / scrolled state: inset from the top and the page sides. */
  html.nav-scrolled .site-header {
    top: var(--nav-inset-y);
    margin-inline: var(--nav-inset-x);
  }

  /* Outer max-width keeps the bar inside the content container; the inner
     padding is solved so the bar's content lines up with the page container's
     content at every width. */
  .nav-bar {
    position: relative;
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
    /* Flush state: full-bleed band, square corners, no shadow. The border is
       always present (transparent) so nothing reflows as it fades in. */
    max-width: 100%;
    min-height: var(--nav-height);
    padding-inline: var(--nav-pad-flush);
    background: var(--nav-surface);
    border: 1px solid transparent;
    border-radius: 0;
    box-shadow: none;
    color: var(--nav-ink);
    transition:
      max-width var(--nav-dur) var(--ease-out),
      padding var(--nav-dur) var(--ease-out),
      border-radius var(--nav-dur) var(--ease-out),
      border-color var(--nav-dur) var(--ease-out),
      box-shadow var(--nav-dur) var(--ease-out);
  }

  /* Detached / scrolled state: the floating inset rounded bar. */
  html.nav-scrolled .nav-bar {
    max-width: var(--nav-max-float);
    padding-inline: var(--nav-pad-float);
    border-color: var(--nav-line);
    border-radius: var(--nav-radius);
    box-shadow: var(--nav-shadow);
  }

  /* --- Brand ------------------------------------------------------------- */
  .nav-brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--nav-ink);
    text-decoration: none;
  }

  .nav-brand__word {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* --- Centre links ------------------------------------------------------ */
  .nav-links {
    justify-self: center;
  }

  .nav-links__list {
    display: flex;
    align-items: center;
    list-style: none;
  }

  .nav-links__list li {
    display: flex;
    align-items: center;
  }

  /* Middle-dot separators: decorative, never part of the link text. */
  .nav-links__list li + li::before {
    content: '·';
    margin-inline: 0.8rem;
    color: color-mix(in srgb, var(--nav-muted) 65%, transparent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
  }

  .nav-links__list a {
    padding-block: 0.35rem;
    color: var(--nav-ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-links__list a:hover {
    color: var(--trigger);
  }

  /* --- Utilities --------------------------------------------------------- */
  .nav-utils {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: clamp(0.5rem, 1.4vw, 1rem);
  }

  .nav-clock {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--nav-muted);
    white-space: nowrap;
  }

  .nav-clock__time {
    min-width: 8ch; /* HH:MM:SS — no layout shift as the seconds tick */
    color: var(--nav-ink);
    font-variant-numeric: tabular-nums;
  }

  /* Segmented language switch with a sliding background. */
  .nav-lang {
    position: relative;
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: center;
    padding: 3px;
    background: var(--nav-raise);
    border: 1px solid var(--nav-line);
    border-radius: 999px;
  }

  .nav-lang__thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    background: var(--nav-active);
    border-radius: 999px;
    transition: transform 0.22s var(--ease-out);
  }

  .nav-lang:has([data-lang-set='en'][aria-current]) .nav-lang__thumb {
    transform: translateX(100%);
  }

  .nav-lang__opt {
    position: relative;
    z-index: 1;
    padding: 0.28rem 0.62rem;
    border: 0;
    background: none;
    border-radius: 999px;
    color: var(--nav-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .nav-lang__opt[aria-current='page'] {
    color: var(--nav-ink);
  }

  .nav-lang__opt:hover:not([aria-current='page']) {
    color: var(--nav-ink);
  }

  /* --- Burger (mobile only, JS only) ------------------------------------- */
  .nav-burger {
    display: none;
    position: relative;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--nav-line);
    border-radius: 10px;
    background: transparent;
    color: var(--nav-ink);
    cursor: pointer;
  }

  .nav-burger span {
    position: absolute;
    left: 50%;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transform: translateX(-50%);
    transition:
      transform 0.2s var(--ease-out),
      opacity 0.2s var(--ease-out);
  }

  .nav-burger span:nth-child(1) {
    top: 12px;
  }

  .nav-burger span:nth-child(2) {
    top: 17px;
  }

  .nav-burger span:nth-child(3) {
    top: 22px;
  }

  .site-header[data-nav-open] .nav-burger span:nth-child(1) {
    transform: translateX(-50%) translateY(5px) rotate(45deg);
  }

  .site-header[data-nav-open] .nav-burger span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-nav-open] .nav-burger span:nth-child(3) {
    transform: translateX(-50%) translateY(-5px) rotate(-45deg);
  }

  /* Visible focus on the dark field: the global spark ring is too dark here. */
  .site-header :focus-visible {
    outline: 2px solid var(--nav-ink);
    outline-offset: 2px;
  }

  /* Reduced motion: the flush ↔ detached hand-off is instant. The global
     reduced-motion rule already collapses every duration, but state it here
     explicitly so the nav's two states never animate on their own. */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-bar {
      transition: none;
    }
  }

  /* --- Mobile ------------------------------------------------------------ */
  @media (max-width: 700px) {
    /* No-JS fallback: the bar wraps, the links take a full second row and
       nothing overflows. */
    .nav-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      height: auto;
      min-height: var(--nav-height);
      padding-block: 0.5rem;
      row-gap: 0.35rem;
    }

    .nav-brand {
      margin-inline-end: auto;
    }

    .nav-utils {
      order: 2;
    }

    .nav-links {
      order: 3;
      flex-basis: 100%;
    }

    .nav-links__list {
      flex-wrap: wrap;
    }

    .nav-links__list li + li::before {
      margin-inline: 0.5rem;
    }

    /* JS: collapse the links into a dropdown and reveal the burger. */
    html.nav-js .nav-bar {
      flex-wrap: nowrap;
      height: var(--nav-height);
      min-height: 0;
      padding-block: 0;
    }

    html.nav-js .nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      order: initial;
      flex-basis: auto;
      display: none;
      padding: 0.5rem;
      background: var(--nav-surface);
      border: 1px solid var(--nav-line);
      border-radius: var(--nav-radius);
      box-shadow: var(--nav-shadow);
    }

    html.nav-js .site-header[data-nav-open] .nav-links {
      display: block;
    }

    html.nav-js .nav-links__list {
      flex-direction: column;
      align-items: stretch;
    }

    html.nav-js .nav-links__list li + li {
      border-top: 1px solid var(--nav-line);
    }

    html.nav-js .nav-links__list li + li::before {
      content: none;
    }

    html.nav-js .nav-links__list a {
      display: block;
      padding: 0.75rem 0.6rem;
    }

    html.nav-js .nav-burger {
      display: inline-block;
      flex: none;
    }
  }

  /* Very small widths: drop the clock so nothing crowds or overflows. */
  @media (max-width: 480px) {
    .nav-clock {
      display: none;
    }
  }

  /* Hidden from sight, available to assistive tech. */
  .nav-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
