  .hero__foam--halo {
    stroke-width: 30;
    opacity: 0.2;
  }

  .hero__foam--band {
    stroke-width: 14;
    opacity: 0.5;
  }

  /* Crest bubbles: real fills (not strokes) so they read as foam texture along
     the waterline; per-circle opacity sets the density. */
  .hero__foam-bubble {
    fill: var(--foam);
  }

  /* --- Motion: gated on js-motion + no-preference ----------------------- */
  /* With no JS (no `js-motion`) or under reduced motion the whole scene rests
     in its static, fully-rendered state. Each layer has a different horizontal
     drift, vertical amplitude, duration and negative delay, so the waterline
     and the internal bands advance/retreat organically and out of phase. */
  @media (prefers-reduced-motion: no-preference) {
    html.js-motion .hero__wave {
      will-change: transform;
      animation: hero-shore-drift var(--dx-dur, 12s) ease-in-out
        var(--dx-delay, 0s) infinite alternate;
    }

    html.js-motion .hero__wave-svg {
      will-change: transform;
      animation: hero-shore-swell var(--dy-dur, 9s) ease-in-out
        var(--dy-delay, 0s) infinite alternate;
    }

    html.js-motion .hero__sand-wet {
      will-change: transform;
      animation: hero-sand-wet 4.8s ease-in-out -1.8s infinite alternate;
    }

    html.js-motion .hero__sand-damp {
      will-change: transform, opacity;
      animation: hero-sand-damp 7.8s ease-in-out -3s infinite;
    }

    /* Deep: broadest swells, slowest drift. */
    html.js-motion .hero__wave--deep {
      --dx-dur: 10.5s;
      --dx-delay: -4s;
      --dx: 1.5%;
      --dy-dur: 8s;
      --dy-delay: -6s;
      --amp: 12px;
    }

    /* Mid. */
    html.js-motion .hero__wave--mid {
      --dx-dur: 7.6s;
      --dx-delay: -8s;
      --dx: 2.2%;
      --dy-dur: 5.8s;
      --dy-delay: -3s;
      --amp: 16px;
    }

    /* Shallow + foam share timing so the foam band stays welded to the
       waterline, but they run faster and lighter than the sea behind. */
    html.js-motion .hero__wave--shallow,
    html.js-motion .hero__wave--foam {
      --dx-dur: 6s;
      --dx-delay: -2s;
      --dx: 2.8%;
      --dy-dur: 4.3s;
      --dy-delay: -1.4s;
      --amp: 14px;
    }

    /* The foam core breathes independently of the shared transform; the halo
       and band keep their own fixed low opacity so the edge stays soft. */
    html.js-motion .hero__foam:not(.hero__foam--halo):not(.hero__foam--band) {
      animation: hero-foam-pulse 3.8s ease-in-out -1.2s infinite alternate;
    }
  }

  /* Horizontal drift half-stroke; `alternate` plays it back, so from/to are
     one side each and the loop never rewinds. */
  @keyframes hero-shore-drift {
    from {
      transform: translate3d(calc(-1 * var(--dx, 2%)), 0, 0);
    }
    to {
      transform: translate3d(var(--dx, 2%), 0, 0);
    }
  }

  /* Vertical advance/retreat (the waterline moving up the beach and back). */
  @keyframes hero-shore-swell {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-1 * var(--amp, 14px)));
    }
  }

  /* Wet sand extends up with the advancing water and retreats with it. */
  @keyframes hero-sand-wet {
