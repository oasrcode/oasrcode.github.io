  @keyframes hero-sand-damp {
    0% {
      transform: translateY(8px);
      opacity: 0.16;
    }
    30% {
      transform: translateY(-34px);
      opacity: 0.5;
    }
    55% {
      transform: translateY(-34px);
      opacity: 0.4;
    }
    82% {
      transform: translateY(4px);
      opacity: 0.18;
    }
    100% {
      transform: translateY(8px);
      opacity: 0.16;
    }
  }

  /* Foam fades in as a wave advances, then softens on the retreat. */
  @keyframes hero-foam-pulse {
    from {
      opacity: 0.7;
    }
    to {
      opacity: 1;
    }
  }
